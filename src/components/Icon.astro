const body = paths[name] || '';
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={body}
></svg>
<style>
  svg { width: 1em; height: 1em; display: inline-block; flex-shrink: 0; }
</style>
