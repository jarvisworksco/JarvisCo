---
import { contact, finalCta, brand } from '@data/content.js';
import Icon from './Icon.astro';
import InquiryForm from './InquiryForm.astro';
---
<section class="section contact" id="kontaktai">
  <div class="container">
    <div class="contact__grid">
      <!-- Kairė: CTA + kontaktai -->
      <div class="contact__info">
        <span class="eyebrow" data-reveal="up">{contact.eyebrow}</span>
        <h2 data-reveal="up">{finalCta.title}</h2>
        <p class="contact__lead" data-reveal="up">{finalCta.lead}</p>

        <div class="contact__methods" data-reveal="up">
          <a href={brand.telefonasHref} class="contact__method">
            <span class="contact__method-ico"><Icon name="phone" /></span>
            <span><span class="contact__method-label">Telefonu</span><strong>{brand.telefonas}</strong></span>
          </a>
          <a href={brand.elPastasHref} class="contact__method">
            <span class="contact__method-ico"><Icon name="mail" /></span>
            <span><span class="contact__method-label">El. paštu</span><strong>{brand.elPastas}</strong></span>
          </a>
          <a href={brand.gbp} target="_blank" rel="noopener" class="contact__method">
            <span class="contact__method-ico"><Icon name="pin" /></span>
            <span><span class="contact__method-label">„Google“ profilis</span><strong>JarvisCo</strong></span>
          </a>
          <div class="contact__method contact__method--static">
            <span class="contact__method-ico"><Icon name="clock" /></span>
            <span><span class="contact__method-label">Darbo laikas</span><strong>{brand.darboLaikas}</strong></span>
          </div>
        </div>
      </div>

      <!-- Dešinė: forma -->
      <div class="contact__form-wrap" data-reveal="right">
        <h3 class="contact__form-title">{contact.formTitle}</h3>
        <InquiryForm showMessage={true} source="kontaktai" />
      </div>
    </div>
  </div>
</section>

<style>
  .contact { background: var(--ink-2); border-top: 1px solid var(--line); }
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
  }
  .contact__lead { color: var(--text-soft); font-size: 1.12rem; margin-top: 1.1rem; max-width: 460px; }

  .contact__methods { display: grid; gap: 0.75rem; margin-top: 2rem; }
  .contact__method {
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    transition: border-color 0.3s, transform 0.3s;
  }
  a.contact__method:hover { border-color: var(--accent); transform: translateX(4px); }
  .contact__method-ico {
    width: 44px; height: 44px; flex-shrink: 0;
    display: grid; place-items: center; border-radius: 12px;
    background: rgba(198,242,78,0.12); color: var(--accent); font-size: 1.2rem;
  }
  .contact__method-label { display: block; color: var(--muted); font-size: 0.82rem; }
  .contact__method strong { font-family: var(--font-display); }

  .contact__form-wrap {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-xl);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    box-shadow: var(--shadow-lg);
  }
  .contact__form-title { font-size: 1.4rem; margin-bottom: 1.5rem; }

  @media (max-width: 900px) { .contact__grid { grid-template-columns: 1fr; } }
</style>
