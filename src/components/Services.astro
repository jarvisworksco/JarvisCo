---
import { services } from '@data/content.js';
import Icon from './Icon.astro';

const icons = { svetaine: 'device', augimas: 'growth' };
---
<section class="section services" id="paslaugos">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow" data-reveal="up">{services.eyebrow}</span>
      <h2 data-reveal="up">{services.title}</h2>
      <p data-reveal="up">{services.lead}</p>
    </div>

    <div class="offers" data-spotlight-group>
      {services.offers.map((o) => (
        <article class={`offer ${o.featured ? 'offer--featured' : ''}`} data-reveal="up" data-spotlight>
          {o.badge && <span class="offer__badge">{o.badge}</span>}
          <div class="offer__head">
            <span class="offer__icon"><Icon name={icons[o.id] || 'spark'} /></span>
            <div>
              <span class="offer__type">{o.tipas}</span>
              <h3 class="offer__name">{o.pavadinimas}</h3>
            </div>
          </div>

          <div class="offer__price">
            <span class="offer__price-prefix">{o.kainaPrefix}</span>
            <span class="offer__price-val">{o.kaina}</span>
            <span class="offer__price-suffix">{o.kainaSuffix}</span>
          </div>
          <p class="offer__price-note">{o.kainaNote}</p>

          <p class="offer__desc">{o.aprasymas}</p>

          <ul class="offer__features">
            {o.features.map((f) => (
              <li><span class="offer__check"><Icon name="check" /></span>{f}</li>
            ))}
          </ul>

          <a href={o.cta.href} class={`btn ${o.featured ? 'btn--primary' : 'btn--ghost'} btn--block btn--lg`}>
            {o.cta.label}<Icon name="arrow" />
          </a>
        </article>
      ))}
    </div>

    <p class="services__note" data-reveal="up">
      <Icon name="spark" />{services.note}
    </p>
  </div>
</section>

<style>
  .offers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }
  .offer {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    overflow: hidden;
    transition: transform 0.5s var(--ease), border-color 0.4s;
  }
  /* cursor spotlight */
  .offer::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.4s;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), rgba(198,242,78,0.10), transparent 60%);
    pointer-events: none;
  }
  .offer:hover { transform: translateY(-6px); border-color: var(--line-strong); }
  .offer:hover::before { opacity: 1; }

  .offer--featured {
    border-color: rgba(198,242,78,0.45);
    background: linear-gradient(180deg, rgba(198,242,78,0.06), var(--surface) 30%);
    box-shadow: 0 30px 80px -40px rgba(198,242,78,0.4);
  }
  .offer__badge {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 0.4rem 0.8rem;
    border-radius: var(--r-pill);
  }

  .offer__head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.75rem; }
  .offer__icon {
    width: 52px; height: 52px;
    display: grid; place-items: center;
    border-radius: 14px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--accent);
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .offer--featured .offer__icon { background: rgba(198,242,78,0.12); border-color: rgba(198,242,78,0.3); }
  .offer__type { font-size: 0.82rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .offer__name { font-size: 1.5rem; margin-top: 0.15rem; }

  .offer__price { display: flex; align-items: baseline; gap: 0.4rem; }
  .offer__price-prefix { color: var(--muted); font-size: 1rem; }
  .offer__price-val {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 3.4rem);
    font-weight: 700;
    line-height: 1;
    color: var(--text);
    letter-spacing: -0.03em;
  }
  .offer__price-suffix { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; color: var(--accent); }
  .offer__price-note { color: var(--muted); font-size: 0.9rem; margin-top: 0.5rem; }

  .offer__desc { color: var(--text-soft); margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }

  .offer__features { display: grid; gap: 0.85rem; margin: 1.5rem 0 2rem; }
  .offer__features li { display: flex; gap: 0.75rem; align-items: flex-start; color: var(--text-soft); font-size: 0.98rem; line-height: 1.5; }
  .offer__check {
    flex-shrink: 0;
    width: 22px; height: 22px;
    margin-top: 1px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: rgba(198,242,78,0.12);
    color: var(--accent);
    font-size: 0.85rem;
  }
  .offer a.btn { margin-top: auto; }

  .services__note {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    justify-content: center;
    text-align: center;
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: 0.98rem;
  }
  .services__note :global(svg) { color: var(--accent); font-size: 1.2rem; flex-shrink: 0; }

  @media (max-width: 760px) {
    .offers { grid-template-columns: 1fr; }
  }
</style>

<script>
  const cards = document.querySelectorAll('[data-spotlight]');
  if (!window.matchMedia('(pointer: coarse)').matches) {
    cards.forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }
</script>
