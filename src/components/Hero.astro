---
import { hero, brand } from '@data/content.js';
import Icon from './Icon.astro';
import InquiryForm from './InquiryForm.astro';
---
<section class="hero" id="top">
  <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__badge pill" data-hero-el>
        <span class="dot"></span>{hero.badge}
      </span>

      <h1 class="hero__title">
        <span class="line"><span class="line__in">{hero.titleLines[0]}</span></span>
        <span class="line"><span class="line__in gradient-text">{hero.titleLines[1]}</span></span>
        <span class="line"><span class="line__in">{hero.titleLines[2]}</span></span>
      </h1>

      <p class="hero__lead" data-hero-el>{hero.lead}</p>

      <div class="hero__actions" data-hero-el>
        <a href={hero.ctaSecondary.href} class="btn btn--ghost btn--lg">
          {hero.ctaSecondary.label}<Icon name="arrow" />
        </a>
        <a href={brand.telefonasHref} class="hero__call">
          <Icon name="phone" />{brand.telefonas}
        </a>
      </div>

      <ul class="hero__stats" data-hero-el>
        {hero.stats.map((s) => (
          <li class="hero__stat">
            <span class="hero__stat-val">{s.value}</span>
            <span class="hero__stat-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- CTA forma su žmogiškuoju prisilietimu -->
    <div class="hero__form" data-hero-el id="pasiulymas">
      <div class="hero__form-head">
        <img class="hero__avatar" src="/assets/images/matas-avatar.webp" alt="Matas Bašinskas" width="320" height="320" loading="eager" />
        <div>
          <strong class="hero__form-title">Gaukite nemokamą pasiūlymą</strong>
          <span class="hero__form-sub">Atsako Matas — per kelias valandas</span>
        </div>
      </div>
      <InquiryForm showMessage={true} source="hero" submitLabel="Gauti pasiūlymą" />
    </div>
  </div>

  <a href="#paslaugos" class="hero__scroll" aria-label="Slinkti žemyn">
    <span class="hero__scroll-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 120px 90px;
    overflow: hidden;
  }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(900px 700px at 50% 45%, transparent, var(--ink) 82%),
      linear-gradient(to bottom, transparent 55%, var(--ink) 98%);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    width: 100%;
  }

  .hero__copy { max-width: 620px; }
  .hero__badge { margin-bottom: 1.5rem; }

  .hero__title { margin-bottom: 1.5rem; font-size: clamp(2.5rem, 5.2vw, 4.4rem); }
  .hero__title .line { display: block; overflow: hidden; padding-block: 0.04em; }
  .hero__title .line__in { display: inline-block; }

  .hero__lead {
    max-width: 540px;
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    color: var(--text-soft);
    margin-bottom: 1.75rem;
  }

  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-bottom: 2.5rem; }
  .hero__call {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-display); font-weight: 600; color: var(--text-soft);
    transition: color 0.25s;
  }
  .hero__call :global(svg) { color: var(--accent); }
  .hero__call:hover { color: var(--text); }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    width: fit-content;
  }
  .hero__stat { display: flex; flex-direction: column; gap: 0.2rem; }
  .hero__stat-val {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hero__stat-label { font-size: 0.8rem; color: var(--muted); }

  /* Forma */
  .hero__form {
    background: rgba(18, 23, 27, 0.82);
    backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-xl);
    padding: clamp(1.5rem, 3vw, 2rem);
    box-shadow: var(--shadow-lg);
    justify-self: end;
    width: 100%;
    max-width: 440px;
  }
  .hero__form-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .hero__avatar {
    width: 84px; height: 84px; border-radius: 50%;
    object-fit: cover; object-position: center; flex-shrink: 0;
    border: 2px solid var(--accent);
  }
  .hero__form-title { display: block; font-family: var(--font-display); font-size: 1.2rem; line-height: 1.2; }
  .hero__form-sub { display: block; color: var(--accent); font-size: 0.85rem; margin-top: 0.15rem; }

  .hero__scroll {
    position: absolute;
    left: 50%; bottom: 22px;
    transform: translateX(-50%);
    z-index: 2;
    width: 26px; height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    display: grid; place-items: start center;
    padding-top: 7px;
  }
  .hero__scroll-line {
    width: 3px; height: 9px; border-radius: 999px;
    background: var(--accent);
    animation: scrolldot 1.8s var(--ease) infinite;
  }
  @keyframes scrolldot {
    0% { transform: translateY(0); opacity: 0; }
    30% { opacity: 1; }
    60% { transform: translateY(14px); opacity: 0; }
    100% { opacity: 0; }
  }

  html.js .hero [data-hero-el] { opacity: 0; transform: translateY(22px); }
  html.js .hero .line__in { transform: translateY(115%); }

  @media (prefers-reduced-motion: reduce) {
    html.js .hero [data-hero-el] { opacity: 1; transform: none; }
    html.js .hero .line__in { transform: none; }
    .hero__scroll-line { animation: none; }
  }

  @media (max-width: 960px) {
    .hero { min-height: auto; padding-block: 110px 64px; }
    .hero__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero__copy { max-width: 640px; }
    .hero__form { justify-self: stretch; max-width: none; }
    .hero__scroll { display: none; }
  }
  @media (max-width: 540px) {
    .hero__stats { grid-template-columns: repeat(2, 1fr); gap: 1.25rem 1.5rem; width: 100%; }
    .hero__actions .btn { flex: 1 1 auto; }
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.querySelector('[data-hero-canvas]');
  if (canvas instanceof HTMLCanvasElement && window.WebGLRenderingContext) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(58, 1, 0.1, 100);
    camera.position.z = 15;

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance',
      });
    } catch (e) {
      // WebGL nepalaikomas — paliekame foną tuščią
    }

    if (renderer) {
      renderer.setClearColor(0x000000, 0);
      const DPR = Math.min(window.devicePixelRatio || 1, 2);
      renderer.setPixelRatio(DPR);

      const group = new THREE.Group();
      scene.add(group);

      const COUNT = window.innerWidth < 768 ? 2800 : 5400;
      const positions = new Float32Array(COUNT * 3);
      const seeds = new Float32Array(COUNT);
      const R = 6.2;
      for (let i = 0; i < COUNT; i++) {
        const t = i / COUNT;
        const phi = Math.acos(1 - 2 * t);
        const theta = Math.PI * (1 + Math.sqrt(5)) * i;
        positions[i * 3] = R * Math.sin(phi) * Math.cos(theta);
        positions[i * 3 + 1] = R * Math.sin(phi) * Math.sin(theta);
        positions[i * 3 + 2] = R * Math.cos(phi);
        seeds[i] = Math.random();
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geo.setAttribute('aSeed', new THREE.BufferAttribute(seeds, 1));

      const uniforms = {
        uTime: { value: 0 },
        uSize: { value: DPR * 17 },
        uColorA: { value: new THREE.Color('#C6F24E') },
        uColorB: { value: new THREE.Color('#74E6FF') },
      };

      const mat = new THREE.ShaderMaterial({
        uniforms,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexShader: `
          uniform float uTime;
          uniform float uSize;
          attribute float aSeed;
          varying float vMix;
          varying float vA;
          void main() {
            vec3 p = position;
            float t = uTime * 0.28;
            float n = sin(p.x * 0.55 + t) * cos(p.y * 0.6 - t) + sin(p.z * 0.7 + t * 1.2);
            p += normalize(position) * n * 0.5;
            p += normalize(position) * sin(t * 2.0 + aSeed * 6.2831) * 0.18;
            vec4 mv = modelViewMatrix * vec4(p, 1.0);
            gl_Position = projectionMatrix * mv;
            gl_PointSize = uSize * (1.0 / -mv.z) * (0.55 + aSeed * 0.9);
            vMix = clamp((p.y + 6.5) / 13.0, 0.0, 1.0);
            vA = 0.35 + aSeed * 0.55;
          }
        `,
        fragmentShader: `
          precision mediump float;
          uniform vec3 uColorA;
          uniform vec3 uColorB;
          varying float vMix;
          varying float vA;
          void main() {
            vec2 uv = gl_PointCoord - 0.5;
            float d = length(uv);
            if (d > 0.5) discard;
            float a = smoothstep(0.5, 0.0, d);
            vec3 col = mix(uColorA, uColorB, vMix);
            gl_FragColor = vec4(col, a * vA);
          }
        `,
      });
      const points = new THREE.Points(geo, mat);
      group.add(points);

      const ico = new THREE.Mesh(
        new THREE.IcosahedronGeometry(3.5, 1),
        new THREE.MeshBasicMaterial({ color: 0xc6f24e, wireframe: true, transparent: true, opacity: 0.1 })
      );
      group.add(ico);

      function resize() {
        const w = canvas.clientWidth || window.innerWidth;
        const h = canvas.clientHeight || window.innerHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }
      resize();
      window.addEventListener('resize', resize);

      let tx = 0, ty = 0, mx = 0, my = 0;
      window.addEventListener('pointermove', (e) => {
        tx = (e.clientX / window.innerWidth - 0.5);
        ty = (e.clientY / window.innerHeight - 0.5);
      }, { passive: true });

      const clock = new THREE.Clock();
      let running = true;

      function render() {
        const dt = clock.getDelta();
        uniforms.uTime.value += dt;
        mx += (tx - mx) * 0.05;
        my += (ty - my) * 0.05;
        group.rotation.y += dt * 0.06;
        group.rotation.x = my * 0.35;
        ico.rotation.y -= dt * 0.12;
        ico.rotation.x += dt * 0.05;
        camera.position.x = mx * 2.4;
        camera.position.y = -my * 1.8;
        camera.lookAt(0, 0, 0);
        renderer.render(scene, camera);
      }

      function loop() {
        if (!running) return;
        render();
        requestAnimationFrame(loop);
      }

      if (reduce) {
        render();
      } else {
        loop();
        const io = new IntersectionObserver((entries) => {
          const vis = entries[0].isIntersecting;
          if (vis && !running) { running = true; clock.getDelta(); loop(); }
          if (!vis) running = false;
        }, { threshold: 0 });
        io.observe(canvas);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) { running = false; }
          else if (!running) { running = true; clock.getDelta(); loop(); }
        });
      }
    }
  }
</script>
