---
import { trust } from '@data/content.js';
const loop = [...trust.items, ...trust.items];
---
<section class="trust section--tight" aria-label={trust.text}>
  <div class="container">
    <p class="trust__label" data-reveal="up">{trust.text}</p>
  </div>
  <div class="trust__marquee" data-reveal="up">
    <div class="trust__track">
      {loop.map((item) => (
        <span class="trust__item">{item}<span class="trust__sep">✦</span></span>
      ))}
    </div>
  </div>
</section>

<style>
  .trust { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--ink-2); }
  .trust__label {
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    margin-bottom: 1.75rem;
  }
  .trust__marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .trust__track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }
  .trust__item {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--text-soft);
    padding-inline: 0;
    white-space: nowrap;
  }
  .trust__sep { color: var(--accent); margin-inline: clamp(1.25rem, 3vw, 2.5rem); font-size: 0.7em; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .trust__track { animation: none; } }
  .trust__marquee:hover .trust__track { animation-play-state: paused; }
</style>
