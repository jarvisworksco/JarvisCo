---
import { brand, nav, footer } from '@data/content.js';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="#top" class="logo">
          <span class="logo__text">Jarvis<span class="accent">Co</span></span>
        </a>
        <p class="footer__tagline">{footer.tagline}</p>
        <a href={brand.atsiliepimoLink} target="_blank" rel="noopener" class="footer__review">
          <Icon name="star" />{footer.reviewCta}
        </a>
        <div class="footer__social">
          <a href={brand.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <Icon name="facebook" />
          </a>
          <a href={brand.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <Icon name="instagram" />
          </a>
        </div>
      </div>

      <nav class="footer__nav" aria-label="Poraštės navigacija">
        <span class="footer__nav-title">Naršymas</span>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="#kontaktai">Kontaktai</a>
      </nav>

      <div class="footer__contact">
        <span class="footer__nav-title">Susisiekite</span>
        <a href={brand.telefonasHref}><Icon name="phone" />{brand.telefonas}</a>
        <a href={brand.elPastasHref}><Icon name="mail" />{brand.elPastas}</a>
        <span class="footer__line"><Icon name="pin" />{brand.regionas}</span>
        <span class="footer__line"><Icon name="clock" />{brand.darboLaikas}</span>
      </div>
    </div>

    <hr class="hairline" />

    <div class="footer__bottom">
      <span>{footer.legal}</span>
      <span class="footer__built">{footer.builtWith}</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--ink); border-top: 1px solid var(--line); padding-block: clamp(3rem, 6vw, 4.5rem) 2rem; }
  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .footer .logo__text { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; }
  .footer__tagline { color: var(--muted); margin: 1.1rem 0 1.5rem; max-width: 380px; }
  .footer__review {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.6rem 1.1rem; border-radius: var(--r-pill);
    border: 1px solid var(--line-strong); color: var(--text-soft);
    font-size: 0.9rem; font-weight: 500; transition: border-color 0.3s, color 0.3s;
  }
  .footer__review :global(svg) { color: var(--accent); }
  .footer__review:hover { border-color: var(--accent); color: var(--text); }

  .footer__social { display: flex; gap: 0.7rem; margin-top: 1.25rem; }
  .footer__social a {
    display: grid; place-items: center;
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text-soft);
    transition: border-color 0.3s, color 0.3s, transform 0.3s;
  }
  .footer__social a:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }
  .footer__social :global(svg) { font-size: 1.15rem; }

  .footer__nav, .footer__contact { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer__nav-title {
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .footer__nav a, .footer__contact a, .footer__line {
    display: inline-flex; align-items: center; gap: 0.55rem;
    color: var(--text-soft); font-size: 0.95rem; transition: color 0.25s;
  }
  .footer__nav a:hover, .footer__contact a:hover { color: var(--accent); }
  .footer__contact :global(svg), .footer__line :global(svg) { color: var(--accent); font-size: 1rem; }
  .footer__line { color: var(--muted); }

  .footer__bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    padding-top: 1.75rem; color: var(--muted); font-size: 0.88rem;
  }
  .footer__built { color: #5e6663; }

  @media (max-width: 760px) {
    .footer__top { grid-template-columns: 1fr; gap: 2rem; }
    .footer__bottom { flex-direction: column; gap: 0.5rem; }
  }
</style>
