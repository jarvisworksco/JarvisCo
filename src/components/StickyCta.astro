---
import { brand } from '@data/content.js';
import Icon from './Icon.astro';
---
<div class="sticky-cta" role="region" aria-label="Greiti veiksmai">
  <a href={brand.telefonasHref} class="sticky-cta__call">
    <Icon name="phone" /><span>Skambinti</span>
  </a>
  <a href="#kontaktai" class="sticky-cta__main">
    Gauti pasiūlymą<Icon name="arrow" />
  </a>
</div>

<style>
  .sticky-cta {
    display: none;
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 90;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem calc(0.7rem + env(safe-area-inset-bottom, 0px));
    /* Vientisas fonas (be backdrop-filter) — kad slenkant liktų užfiksuota vietoje. */
    background: var(--ink);
    border-top: 1px solid var(--line-strong);
  }
  .sticky-cta__call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex: 0 0 auto;
    padding: 0 1.1rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .sticky-cta__call :global(svg) { color: var(--accent); }
  .sticky-cta__main {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex: 1 1 auto;
    padding: 0.9rem 1.2rem;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
  }

  @media (max-width: 720px) {
    .sticky-cta { display: flex; }
    /* vietos apačioje, kad juosta nedengtų turinio */
    :global(.footer) { padding-bottom: calc(2rem + 76px); }
  }
</style>
