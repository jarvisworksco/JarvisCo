---
import { brand } from '@data/content.js';
import Icon from './Icon.astro';

const {
  title = 'Norite tokių pat rezultatų savo verslui?',
  text = 'Sukursiu svetainę, kuri dirba Jūsų vardu — pritraukia užklausas ir kelia pasitikėjimą.',
  ctaLabel = 'Gauti nemokamą pasiūlymą',
  ctaHref = '#kontaktai',
} = Astro.props;
---
<section class="section--tight ctaband-wrap">
  <div class="container">
    <div class="ctaband" data-reveal="scale">
      <div class="ctaband__bg" aria-hidden="true"></div>
      <div class="ctaband__content">
        <h2 class="ctaband__title">{title}</h2>
        <p class="ctaband__text">{text}</p>
      </div>
      <div class="ctaband__actions">
        <a href={ctaHref} class="btn btn--primary btn--lg">{ctaLabel}<Icon name="arrow" /></a>
        <a href={brand.telefonasHref} class="btn btn--ghost btn--lg"><Icon name="phone" />{brand.telefonas}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .ctaband {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-xl);
    padding: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
    background: linear-gradient(120deg, #0f1a0c, #0c1013 60%);
    border: 1px solid rgba(198,242,78,0.25);
  }
  .ctaband__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(600px 300px at 100% 0%, rgba(198,242,78,0.22), transparent 60%),
      radial-gradient(500px 300px at 0% 100%, rgba(116,230,255,0.12), transparent 60%);
    pointer-events: none;
  }
  .ctaband__content { position: relative; max-width: 620px; }
  .ctaband__title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); }
  .ctaband__text { color: var(--text-soft); margin-top: 0.9rem; font-size: 1.1rem; }
  .ctaband__actions { position: relative; display: flex; flex-direction: column; gap: 0.85rem; flex-shrink: 0; }

  @media (max-width: 720px) {
    .ctaband__actions { width: 100%; }
    .ctaband__actions .btn { width: 100%; }
  }
</style>
