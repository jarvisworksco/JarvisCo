---
import { caseStudy as cs } from '@data/content.js';
import Icon from './Icon.astro';
---
<section class="section case" id="darbai">
  <div class="container">
    <!-- Tekstas: dvi kolonos -->
    <div class="case__top">
      <div class="case__intro">
        <span class="eyebrow" data-reveal="up">{cs.eyebrow}</span>
        <h2 data-reveal="up">{cs.title}</h2>
        <p class="case__lead" data-reveal="up">{cs.lead}</p>

        <div class="case__meta" data-reveal="up">
          <div class="case__meta-item">
            <span class="kicker">Klientas</span>
            <strong>{cs.client}</strong>
          </div>
          <div class="case__meta-item">
            <span class="kicker">Sritis</span>
            <strong>{cs.niche}</strong>
          </div>
        </div>
      </div>

      <div class="case__detail">
        <div class="case__block" data-reveal="up">
          <h3 class="case__block-title">Iššūkis</h3>
          <p>{cs.challenge}</p>
        </div>
        <div class="case__block" data-reveal="up">
          <h3 class="case__block-title">Sprendimas</h3>
          <ul class="case__list">
            {cs.solution.map((s) => (
              <li><span class="case__check"><Icon name="check" /></span>{s}</li>
            ))}
          </ul>
        </div>
        <a href={cs.cta.href} target="_blank" rel="noopener" class="btn btn--ghost" data-reveal="up">
          {cs.cta.label}<Icon name="external" />
        </a>
      </div>
    </div>

    <!-- Gyva svetainės peržiūra (per visą plotį) -->
    <div class="case__visual" data-reveal="scale">
      <div class="preview">
        <div class="preview__bar">
          <span class="preview__dots"><span></span><span></span><span></span></span>
          <span class="preview__url"><Icon name="shield" />{cs.urlLabel}</span>
          <a class="preview__open" href={cs.url} target="_blank" rel="noopener" aria-label="Atidaryti naujame lange">
            <Icon name="external" />
          </a>
        </div>
        <div class="preview__stage" data-preview-stage style={`background-image:url(${cs.imgDesktop})`}>
          <iframe
            class="preview__frame"
            data-preview-frame
            src={cs.url}
            title="ArbCut svetainės gyva peržiūra"
            loading="lazy"
            referrerpolicy="no-referrer"
            sandbox="allow-scripts allow-same-origin allow-popups"
          ></iframe>
          <button class="preview__cover" data-preview-cover type="button">
            <span class="preview__hint"><Icon name="device" /> Gyva peržiūra — spustelėkite ir naršykite</span>
          </button>
        </div>
      </div>
      <p class="preview__note">Tikra, gyva svetainė — naršykite tiesiai čia arba atidarykite naujame lange.</p>
      <div class="case__glow" aria-hidden="true"></div>
    </div>

    <!-- Rezultatai -->
    <div class="case__results">
      {cs.results.map((r) => (
        <div class="result" data-reveal="up">
          <span class="result__val">{r.value}</span>
          <span class="result__label">{r.label}</span>
        </div>
      ))}
    </div>

    <!-- Citata -->
    <figure class="case__quote" data-reveal="up">
      <span class="case__quote-mark"><Icon name="quote" /></span>
      <blockquote>{cs.quote}</blockquote>
      <figcaption>— {cs.quoteAuthor}</figcaption>
    </figure>
  </div>
</section>

<style>
  .case { background: var(--ink-2); border-block: 1px solid var(--line); }

  .case__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .case__lead { color: var(--text-soft); font-size: 1.12rem; margin-top: 1.1rem; }
  .case__meta { display: flex; gap: 2.5rem; margin-top: 1.75rem; }
  .case__meta-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .case__meta-item strong { font-family: var(--font-display); font-size: 1.05rem; }

  .case__block { margin-bottom: 1.5rem; }
  .case__block-title {
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--accent); margin-bottom: 0.6rem; font-family: var(--font-display);
  }
  .case__block p { color: var(--text-soft); }
  .case__list { display: grid; gap: 0.7rem; }
  .case__list li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--text-soft); }
  .case__check {
    flex-shrink: 0; width: 20px; height: 20px; margin-top: 2px;
    display: grid; place-items: center; border-radius: 50%;
    background: rgba(198,242,78,0.12); color: var(--accent); font-size: 0.78rem;
  }

  /* Gyva peržiūra — didelė, per visą plotį */
  .case__visual { position: relative; }
  .case__glow {
    position: absolute; inset: -8% -5% 0 -5%; z-index: -1;
    background: radial-gradient(50% 60% at 50% 20%, var(--glow), transparent 70%);
    filter: blur(24px);
  }
  .preview {
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg);
  }
  .preview__bar {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 12px 16px;
    background: #0c1013;
    border-bottom: 1px solid var(--line);
  }
  .preview__dots { display: inline-flex; gap: 7px; }
  .preview__dots span { width: 12px; height: 12px; border-radius: 50%; background: var(--surface-3); }
  .preview__dots span:nth-child(1) { background: #ff5f57; opacity: 0.55; }
  .preview__dots span:nth-child(2) { background: #febc2e; opacity: 0.55; }
  .preview__dots span:nth-child(3) { background: #28c840; opacity: 0.55; }
  .preview__url {
    display: inline-flex; align-items: center; gap: 0.45rem;
    flex: 1;
    background: var(--ink); color: var(--text-soft);
    font-size: 0.82rem; padding: 0.4rem 0.95rem; border-radius: 999px;
  }
  .preview__url :global(svg) { color: var(--accent); font-size: 0.85rem; }
  .preview__open {
    display: grid; place-items: center;
    width: 32px; height: 32px; border-radius: 8px;
    color: var(--text-soft); border: 1px solid var(--line);
    transition: color 0.25s, border-color 0.25s;
  }
  .preview__open:hover { color: var(--accent); border-color: var(--accent); }

  .preview__stage {
    position: relative;
    width: 100%;
    height: clamp(480px, 72vh, 760px);
    overflow: hidden;
    background-size: cover;
    background-position: top center;
  }
  .preview__frame {
    position: absolute;
    top: 0; left: 0;
    border: 0;
    width: 100%;
    height: 100%;
    transform-origin: top left;
    background: #fff;
    pointer-events: none; /* įjungiama paspaudus */
  }
  .preview__cover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(to top, rgba(10,11,13,0.5), rgba(10,11,13,0.04));
    transition: opacity 0.3s;
  }
  .preview__hint {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--accent); color: var(--accent-ink);
    font-family: var(--font-display); font-weight: 600; font-size: 0.95rem;
    padding: 0.7rem 1.2rem; border-radius: var(--r-pill);
    box-shadow: var(--shadow-md);
  }
  .preview.is-live .preview__cover { opacity: 0; pointer-events: none; }
  .preview.is-live .preview__frame { pointer-events: auto; }
  .preview__note { color: var(--muted); font-size: 0.88rem; margin-top: 0.9rem; text-align: center; }

  /* Rezultatai */
  .case__results {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .result {
    text-align: center;
    padding: 1.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .result__val {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  .result__label { display: block; margin-top: 0.5rem; color: var(--muted); font-size: 0.9rem; }

  /* Citata */
  .case__quote {
    max-width: 760px;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
    text-align: center;
    position: relative;
  }
  .case__quote-mark { color: var(--accent); font-size: 2rem; display: inline-grid; place-items: center; margin-bottom: 0.75rem; }
  .case__quote blockquote {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
  }
  .case__quote figcaption { margin-top: 1rem; color: var(--muted); }

  @media (max-width: 860px) {
    .case__top { grid-template-columns: 1fr; gap: 2rem; }
    .preview__stage { height: clamp(420px, 64vh, 620px); }
  }
  @media (max-width: 640px) {
    .case__results { grid-template-columns: repeat(2, 1fr); }
    .case__meta { gap: 1.75rem; }
  }
</style>

<script>
  const stage = document.querySelector('[data-preview-stage]');
  const frame = document.querySelector('[data-preview-frame]');
  const cover = document.querySelector('[data-preview-cover]');

  if (stage instanceof HTMLElement && frame instanceof HTMLIFrameElement) {
    // Pilnas darbalaukio rodinys, pritaikytas konteinerio pločiui (be priartinimo viršuje).
    const setScale = () => {
      const w = stage.clientWidth;
      if (w >= 560) {
        const logicalW = 1280;
        const scale = w / logicalW;
        const logicalH = Math.round(stage.clientHeight / scale);
        frame.style.width = logicalW + 'px';
        frame.style.height = logicalH + 'px';
        frame.style.transform = `scale(${scale})`;
      } else {
        frame.style.width = '100%';
        frame.style.height = '100%';
        frame.style.transform = 'none';
      }
    };
    setScale();
    if (window.ResizeObserver) new ResizeObserver(setScale).observe(stage);
    window.addEventListener('resize', setScale);

    if (cover) {
      cover.addEventListener('click', () => {
        stage.closest('.preview')?.classList.add('is-live');
      });
    }
  }
</script>
