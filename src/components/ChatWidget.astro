---
// Pokalbio (chat) widget'as, jungiasi prie n8n AI agento.
// Naudoja @n8n/chat biblioteką per CDN (versija prisegta dėl stabilumo);
// krautis tik kliento pusėje.
const webhookUrl =
  'https://jarvico.app.n8n.cloud/webhook/4a3b4cb5-3d0f-4862-b661-7847d659e013/chat';
---

<!-- @n8n/chat stiliai iš CDN -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@n8n/chat@1.25.0/dist/style.css"
/>

<script type="module" define:vars={{ webhookUrl }}>
  import { createChat } from 'https://cdn.jsdelivr.net/npm/@n8n/chat@1.25.0/dist/chat.bundle.es.js';

  // Kiekvieną kartą užkrovus puslapį pradedam pokalbį iš naujo (be senos sesijos).
  localStorage.removeItem('sessionId');

  createChat({
    webhookUrl,
    mode: 'window',
    // Agentas n8n pusėje atsako srautu (streaming) — kitaip widget'as rodytų
    // žalią JSON tekstą vietoje normalios žinutės.
    enableStreaming: true,
    showWelcomeScreen: false,
    loadPreviousSession: true,
    initialMessages: [
      'Sveiki! 👋 Esu JarvisCo asistentas.',
      'Atsakysiu į klausimus apie svetaines ir kainas, o jei norėsite — iškart suderinsiu nemokamą konsultaciją.',
    ],
    i18n: {
      en: {
        title: 'JarvisCo asistentas',
        subtitle: 'Atsakome ir suderiname konsultaciją.',
        footer: '',
        getStarted: 'Naujas pokalbis',
        inputPlaceholder: 'Rašykite žinutę...',
        closeButtonTooltip: 'Uždaryti',
      },
    },
  });
</script>

<style is:global>
  /* @n8n/chat spalvas suderiname su svetainės tema: tamsus fonas (#0A0B0D) ir
     limetinis/geltonas akcentas (#C6F24E), kaip svetainės mygtukai.
     Naudojame :root:root, kad specifiškumas viršytų CDN stiliaus :root taisykles
     (CDN CSS kraunamas vėliau, todėl paprastas :root pralaimėtų). */
  :root:root {
    /* Akcentinė (pirminė) spalva — geltona kaip svetainės mygtukai */
    --chat--color--primary: #c6f24e;
    --chat--color--primary-shade-50: #aee534;
    --chat--color--primary--shade-100: #93c81f;
    --chat--color--secondary: #c6f24e;
    --chat--color-secondary-shade-50: #aee534;

    --chat--color-white: #ffffff;
    --chat--color-light: #12171b;
    --chat--color-light-shade-50: #181f24;
    --chat--color-light-shade-100: #20282e;
    --chat--color-medium: rgba(255, 255, 255, 0.16);
    --chat--color-dark: #0a0b0d;
    --chat--color-disabled: #8c9591;
    --chat--color-typing: #c2c8c5;

    /* @n8n/chat tarpų (spacing) skalė. CDN pakete šie tokenai NEpridėti, todėl
       markdown sąrašų padding-left: calc(var(--spacing--2xs) * 4) sugriūdavo iki
       0 ir numeracija (1. 2.) išlįsdavo už burbulo krašto. Apibrėžiame skalę. */
    --spacing--5xs: 0.125rem;
    --spacing--4xs: 0.25rem;
    --spacing--3xs: 0.375rem;
    --spacing--2xs: 0.5rem;
    --spacing--xs: 0.75rem;
    --spacing--sm: 1rem;
    --spacing--md: 1.25rem;
    --spacing--lg: 1.5rem;
    --spacing--2xl: 2.5rem;

    --chat--spacing: 1rem;
    --chat--border-radius: 16px;
    --chat--transition-duration: 0.2s;

    /* Šriftas perimamas iš svetainės kūno (Inter) */
    --chat--font-family: var(--font-body);

    --chat--window--width: 380px;
    --chat--window--height: 600px;
    --chat--window--border-radius: 20px;
    --chat--window--border: 1px solid rgba(255, 255, 255, 0.085);

    /* Antraštės juosta — tamsus fonas, šviesus tekstas */
    --chat--header--background: #0a0b0d;
    --chat--header--color: #ecefec;
    --chat--heading--font-size: 1.2rem;
    --chat--subtitle--font-size: 0.85rem;

    /* Pokalbio kūnas */
    --chat--body--background: #0d1114;

    /* Burbulo (toggle) mygtukas apatiniame dešiniajame kampe — geltonas */
    --chat--toggle--background: #c6f24e;
    --chat--toggle--hover--background: #aee534;
    --chat--toggle--active--background: #93c81f;
    --chat--toggle--color: #0a0b0d;
    --chat--toggle--size: 60px;

    /* Žinutės */
    --chat--message--bot--background: #181f24;
    --chat--message--bot--color: #ecefec;
    --chat--message--user--background: #c6f24e;
    --chat--message--user--color: #0a0b0d;
    --chat--message--font-size: 0.95rem;
    --chat--message-line-height: 1.55;
    --chat--message--padding: 0.85rem 1.05rem;
    --chat--message--border-radius: 14px;
    --chat--message--margin-bottom: 0.6rem;
    --chat--messages-list--padding: 1.25rem 1rem;
    --chat--message--pre--background: rgba(255, 255, 255, 0.06);

    /* Įvesties laukas */
    --chat--input--background: #12171b;
    --chat--input--container--background: #0d1114;
    --chat--input--text-color: #ecefec;
    --chat--input--send--button--background: #c6f24e;
    --chat--input--send--button--background-hover: #aee534;
    --chat--input--send--button--color: #0a0b0d;
  }

  /* Subtilus šešėlis burbului ir pokalbio langui (premium SaaS jausmas) */
  .chat-window-toggle {
    box-shadow: 0 12px 32px -8px rgba(198, 242, 78, 0.45),
      0 4px 12px rgba(0, 0, 0, 0.35);
  }
  .chat-window {
    box-shadow: 0 40px 80px -24px rgba(0, 0, 0, 0.7);
  }

  /* Žinutės neturi liestis prie kraštų — papildoma erdvė ir teksto laužymas */
  .chat-message {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* Subtilus žinutės pasirodymas (fade + slinktis aukštyn), kad atsakymas
     nebūtų „išspjaunamas" staigiai, o atsirastų sklandžiai ir natūraliai. */
  .chat-message-from-bot,
  .chat-message-from-user {
    animation: chatMsgIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes chatMsgIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* „Rašoma..." 3 taškų burbulas — ryškesnis, sklandus bangavimas */
  .chat-message-typing .chat-message-typing-circle {
    width: 8px;
    height: 8px;
    margin: 2px;
    background-color: var(--chat--color-typing);
  }

  /* Mobiliajame — langas užima visą ekraną (poziciją keičiame tiesiai
     elementui, kad NEnulintume --chat--window--right, kuris lemia žinučių
     šonines paraštes; kitaip tekstas liestųsi prie kraštų). */
  @media (max-width: 640px) {
    :root:root {
      --chat--window--width: 100vw;
      --chat--window--height: 100dvh;
      --chat--window--border-radius: 0;
      --chat--window--border: none;
    }
    .chat-window {
      right: 0 !important;
      bottom: 0 !important;
    }
  }

  /* Mobiliajame burbulą (ir langą) pakeliame virš apatinės CTA juostos (dock,
     rodomos ≤720px, ~76px aukščio), kad nesidengtų su mygtukais. */
  @media (max-width: 720px) {
    :root:root {
      --chat--window--bottom: calc(88px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
