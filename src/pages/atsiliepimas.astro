---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import { brand, reviewPage as r } from '@data/content.js';

const mailto = `${brand.elPastasHref}?subject=${encodeURIComponent('Atsiliepimas / pastaba dėl JarvisCo')}`;
---
<BaseLayout title={r.title} description="Palikite atsiliepimą apie darbą su JarvisCo.">
  <header class="rev-top">
    <a href="/" class="logo"><span class="logo__text">Jarvis<span class="accent">Co</span></span></a>
  </header>

  <main class="rev" id="main">
    <div class="rev__card" data-review data-google={brand.atsiliepimoLink}>
      <span class="eyebrow">{r.eyebrow}</span>
      <h1 class="rev__heading">{r.heading}</h1>
      <p class="rev__lead">{r.lead}</p>

      <div class="rev__stars" role="radiogroup" aria-label="Įvertinimas nuo 1 iki 5" data-stars>
        {[1, 2, 3, 4, 5].map((n) => (
          <button type="button" class="rev__star" data-star={n} role="radio" aria-checked="false" aria-label={`${n} iš 5`}>
            <Icon name="star" />
          </button>
        ))}
      </div>
      <span class="rev__hint" data-hint>{r.starsHint}</span>

      <!-- Teigiamas (4–5★) -->
      <div class="rev__panel" data-panel="positive" hidden>
        <span class="rev__panel-emoji" aria-hidden="true">🌟</span>
        <h2 class="rev__panel-title">{r.positiveTitle}</h2>
        <p class="rev__panel-text">{r.positiveText}</p>
        <a class="btn btn--primary btn--lg" data-google-cta href={brand.atsiliepimoLink} target="_blank" rel="noopener">
          <Icon name="pin" />{r.positiveCta}
        </a>
      </div>

      <!-- Neigiamas (1–3★) -->
      <div class="rev__panel" data-panel="negative" hidden>
        <span class="rev__panel-emoji" aria-hidden="true">🙏</span>
        <h2 class="rev__panel-title">{r.negativeTitle}</h2>
        <p class="rev__panel-text">{r.negativeText}</p>
        <a class="btn btn--primary btn--lg" href={mailto}><Icon name="mail" />{r.negativeCta}</a>
      </div>

      <a href="/" class="rev__back" data-back hidden>{r.back}</a>
    </div>
  </main>
</BaseLayout>

<style>
  .rev-top { padding: 1.5rem var(--gutter); position: relative; z-index: 2; }
  .rev-top .logo__text { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; }

  .rev {
    min-height: 78vh;
    display: grid;
    place-items: center;
    padding: 2rem var(--gutter) 5rem;
    position: relative;
    z-index: 1;
  }
  .rev__card {
    width: 100%;
    max-width: 560px;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-xl);
    padding: clamp(2rem, 5vw, 3.25rem);
    box-shadow: var(--shadow-lg);
  }
  .rev__card .eyebrow { justify-content: center; }
  .rev__heading { font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .rev__lead { color: var(--text-soft); margin-top: 0.9rem; }

  .rev__stars { display: flex; justify-content: center; gap: 0.4rem; margin: 2rem 0 0.75rem; }
  .rev__star {
    font-size: clamp(2.4rem, 8vw, 3.2rem);
    line-height: 1;
    color: var(--muted);
    transition: transform 0.18s var(--ease);
    padding: 0.15rem;
  }
  .rev__star svg { stroke: currentColor; fill: transparent; transition: fill 0.18s, stroke 0.18s; }
  .rev__star.is-on { color: var(--accent); transform: translateY(-3px) scale(1.06); }
  .rev__star.is-on svg { fill: var(--accent); stroke: var(--accent); }
  .rev__star:hover { transform: translateY(-3px) scale(1.06); }
  .rev__hint { display: block; color: var(--muted); font-size: 0.88rem; }

  .rev__panel { margin-top: 2rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }
  .rev__panel-emoji { font-size: 2.2rem; display: block; margin-bottom: 0.5rem; }
  .rev__panel-title { font-size: 1.4rem; }
  .rev__panel-text { color: var(--text-soft); margin: 0.75rem 0 1.5rem; }
  .rev__back { display: inline-block; margin-top: 1.5rem; color: var(--muted); font-size: 0.9rem; text-decoration: underline; text-underline-offset: 3px; }
  .rev__back:hover { color: var(--accent); }
</style>

<script>
  const card = document.querySelector('[data-review]');
  if (card instanceof HTMLElement) {
    const stars = [...card.querySelectorAll('[data-star]')];
    const hint = card.querySelector('[data-hint]');
    const panels = {
      positive: card.querySelector('[data-panel="positive"]'),
      negative: card.querySelector('[data-panel="negative"]'),
    };
    const back = card.querySelector('[data-back]');
    const googleUrl = card.dataset.google || '/';
    let locked = false;

    const paint = (n) => stars.forEach((s, i) => s.classList.toggle('is-on', i < n));

    stars.forEach((star) => {
      const val = Number(star.getAttribute('data-star'));
      star.addEventListener('mouseenter', () => { if (!locked) paint(val); });
      star.addEventListener('click', () => {
        if (locked) return;
        locked = true;
        paint(val);
        stars.forEach((s, i) => s.setAttribute('aria-checked', String(i === val - 1)));
        if (hint instanceof HTMLElement) hint.hidden = true;
        if (back instanceof HTMLElement) back.hidden = false;

        if (val >= 4) {
          if (panels.positive instanceof HTMLElement) panels.positive.hidden = false;
          // Nukreipiam į „Google" atsiliepimo formą.
          setTimeout(() => { window.location.href = googleUrl; }, 1100);
        } else {
          if (panels.negative instanceof HTMLElement) panels.negative.hidden = false;
        }
      });
    });
    card.addEventListener('mouseleave', () => {
      if (!locked) paint(0);
    });
  }
</script>
