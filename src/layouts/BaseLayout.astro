---
import '../styles/global.css';
import { brand, meta } from '@data/content.js';
import { localBusiness, faqSchema } from '@data/jsonld.js';
import ChatWidget from '@components/ChatWidget.astro';

const { title, description, ogImage } = Astro.props;
const pageTitle = title || meta.title;
const desc = description || meta.description;
const canonical = new URL(Astro.url.pathname, brand.url).href;
const ogImg = new URL(ogImage || meta.ogImage, brand.url).href;
const schemas = [localBusiness(), faqSchema()];

const fontsUrl =
  'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap';
---
<!doctype html>
<html lang="lt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={brand.pavadinimas} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="lt_LT" />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand.pavadinimas} — ${brand.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImg} />

    <meta name="theme-color" content="#0A0B0D" />
    <meta name="geo.region" content="LT" />
    <meta name="geo.placename" content="Lietuva" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsUrl} rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- JS žyma reveal animacijoms (be FOUC) -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Pereiti prie turinio</a>
    <div class="noise" aria-hidden="true"></div>
    <slot />
    <ChatWidget />
    <script src="../scripts/animations.js"></script>
  </body>
</html>
